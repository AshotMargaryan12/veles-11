# --- Telegram (обязательно) -------------------------------------------------
# Получить на https://my.telegram.org -> API development tools
# ВАЖНО: использовать ОТДЕЛЬНЫЙ юзер-аккаунт, не личный и не основной корпоративный.
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=hunter
# Каталог, где лежит файл сессии Telethon (в .gitignore)
TG_SESSION_DIR=sessions

# --- Лимиты и безопасность --------------------------------------------------
# Не более одного запроса к API раз в N секунд (+ джиттер)
RATE_MIN_INTERVAL=2.0
RATE_MAX_INTERVAL=3.0
# Максимум НОВЫХ каналов за один прогон
MAX_CHANNELS_PER_RUN=200
# Пауза между методами поиска, секунд
METHOD_PAUSE_MIN=30
METHOD_PAUSE_MAX=60
# Сколько FloodWait подряд до аварийной остановки прогона
FLOODWAIT_ABORT_STREAK=2

# --- Хранилище и выгрузки ---------------------------------------------------
DB_PATH=channels.db
EXPORT_DIR=exports
CONFIG_DIR=config

# --- Сводка в Telegram-бота (опционально) -----------------------------------
TG_BOT_TOKEN=
TG_SUMMARY_CHAT_ID=

# --- TGStat (опционально) ---------------------------------------------------
# Ключ из личного кабинета api.tgstat.ru. С ним источник tgstat работает СРАЗУ,
# без входа по телефону: python -m tghunter --source tgstat search "трейдинг"
# Чего TGStat не отдаёт: реакции, комментарии и нативные рекомендации.
TGSTAT_TOKEN=

# --- amoCRM (опционально, флаг --amo) ---------------------------------------
AMO_BASE_URL=
AMO_ACCESS_TOKEN=
AMO_PIPELINE_ID=
AMO_STATUS_ID=
# ID кастомных полей сделки (числовые id из настроек amoCRM)
AMO_FIELD_LINK=
AMO_FIELD_SUBSCRIBERS=
AMO_FIELD_ER=
AMO_FIELD_STREAM=
AMO_FIELD_SCORE=

# --- Google Sheets (опционально, флаг --sheets) -----------------------------
SHEETS_CREDENTIALS_FILE=
SHEETS_SPREADSHEET_ID=
SHEETS_WORKSHEET_PREFIX=hunting

# ===========================================================================
# Квалификатор партнёра (команда qualify). Telegram-ключи выше общие.
# ===========================================================================

# --- Telegram ---------------------------------------------------------------
# Сколько последних постов читать с канала (просмотры, реклама, частота)
TG_POSTS_LIMIT=50

# --- LLM (Anthropic) --------------------------------------------------------
# Без ключа карточка строится, но без оценки аудитории LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Глубина рассуждений: low | medium | high (пусто — по умолчанию модели)
LLM_EFFORT=medium
# adaptive — модель сама решает, сколько думать; off — без размышлений
LLM_THINKING=adaptive
LLM_MAX_TOKENS=16000

# --- YouTube (опционально) ---------------------------------------------------
# С ключом YouTube Data API v3 — точные цифры, страна и дата создания канала.
# Без ключа — yt-dlp: подписчики и просмотры округлены.
YT_API_KEY=
YT_VIDEOS_LIMIT=10

# --- X / Twitter (опционально) -----------------------------------------------
# Bearer-токен X API v2 с доступом к чтению. Без него по X — «данные недоступны».
X_BEARER_TOKEN=

# --- Кэш, лимиты, пути ------------------------------------------------------
CACHE_TTL_DAYS=7
# Пауза между партнёрами в пакетном режиме, секунд (плюс 2-3 с между запросами к Telegram)
BATCH_PAUSE_SEC=3
QUALIFIER_DB_PATH=qualifier.db
QUALIFIER_CONFIG_DIR=config/qualifier
QUALIFIER_TEMPLATES_DIR=templates
REPORTS_DIR=reports
# Язык черновика заявки: en | ru
DRAFT_LANGUAGE=en
