# --- Telegram (обязательно) -------------------------------------------------
# Получить на https://my.telegram.org -> API development tools
# ВАЖНО: использовать ОТДЕЛЬНЫЙ юзер-аккаунт, не личный и не основной корпоративный.
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=hunter
# Каталог, где лежит файл сессии Telethon (в .gitignore)
TG_SESSION_DIR=sessions

# --- Лимиты и безопасность --------------------------------------------------
# Не более одного запроса к API раз в N секунд (+ джиттер)
RATE_MIN_INTERVAL=2.0
RATE_MAX_INTERVAL=3.0
# Максимум НОВЫХ каналов за один прогон
MAX_CHANNELS_PER_RUN=200
# Пауза между методами поиска, секунд
METHOD_PAUSE_MIN=30
METHOD_PAUSE_MAX=60
# Сколько FloodWait подряд до аварийной остановки прогона
FLOODWAIT_ABORT_STREAK=2

# --- Хранилище и выгрузки ---------------------------------------------------
DB_PATH=channels.db
EXPORT_DIR=exports
CONFIG_DIR=config

# --- Сводка в Telegram-бота (опционально) -----------------------------------
TG_BOT_TOKEN=
TG_SUMMARY_CHAT_ID=

# --- amoCRM (опционально, флаг --amo) ---------------------------------------
AMO_BASE_URL=
AMO_ACCESS_TOKEN=
AMO_PIPELINE_ID=
AMO_STATUS_ID=
# ID кастомных полей сделки (числовые id из настроек amoCRM)
AMO_FIELD_LINK=
AMO_FIELD_SUBSCRIBERS=
AMO_FIELD_ER=
AMO_FIELD_STREAM=
AMO_FIELD_SCORE=

# --- Google Sheets (опционально, флаг --sheets) -----------------------------
SHEETS_CREDENTIALS_FILE=
SHEETS_SPREADSHEET_ID=
SHEETS_WORKSHEET_PREFIX=hunting

# ============================================================================
# ИИ-анализ диалогов Wazzup -> amoCRM (пакет crmai, раздел 7 ТЗ)
# Нужен только для `python -m crmai`; парсеру tghunter эти переменные не нужны.
# ============================================================================

# --- Wazzup -----------------------------------------------------------------
WAZZUP_API_KEY=
# Необязательный общий секрет: если задан, вебхук без него отдаёт 403.
# Передавать в заголовке X-Webhook-Secret или параметром ?secret=
WAZZUP_WEBHOOK_SECRET=

# --- amoCRM -----------------------------------------------------------------
AMO_DOMAIN=              # поддомен: для veles.amocrm.ru укажите veles
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_ACCESS_TOKEN=
AMO_REFRESH_TOKEN=
AMO_REDIRECT_URI=
AMO_MANAGER_USER_ID=     # ID Данила: на него ставятся задачи
PIPELINE_IDS=            # ID воронок хантинг, аккаунтинг через запятую
# Куда класть обновлённую пару токенов после авто-refresh (в .gitignore)
AMO_TOKEN_FILE=amo_tokens.json

# --- LLM --------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Модель из ТЗ. claude-sonnet-5 — текущее поколение Sonnet: дешевле и сильнее
LLM_MODEL=claude-sonnet-4-6
MAX_LLM_CALLS_PER_DAY=200

# --- Telegram ---------------------------------------------------------------
TG_BOT_TOKEN=
TG_CHAT_ASHOT=           # обязательный получатель алертов и дайджеста
TG_CHAT_DANIL=           # опционально
SEND_TO_MANAGER=false

# --- Расписание, хранилище, вебхук ------------------------------------------
BATCH_HOUR=19            # 19:00 статусы, 19:30 качество, 19:45 дайджест
TZ=Europe/Moscow
CRM_DB_PATH=crm_analyzer.db
PROMPTS_DIR=prompts
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
