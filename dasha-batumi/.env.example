# Скопируй этот файл в .env и заполни ОДИН из вариантов.
# Если заполнены оба — используется Telegram.
# Если не заполнен ни один — ответы можно будет переслать кнопкой «поделиться».
# Как получить ключи — в README, раздел «Ответы в Telegram или на почту».

# Вариант 1: Telegram-бот
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Вариант 2: Formspree (письмо на почту)
VITE_FORMSPREE_ID=

# Необязательно: адрес сайта после деплоя, например https://dasha.vercel.app
# Нужен, чтобы в превью ссылки в Telegram была картинка.
VITE_SITE_URL=
